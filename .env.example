# ---------------------------------------------------------------------------
# Neon (Postgres)
# ---------------------------------------------------------------------------
# Neon console > your project > Connect > "Connection string".
# Use the POOLED connection (host contains "-pooler") and keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Admin console auth (/admin)
# ---------------------------------------------------------------------------
# Password for the admin login form.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
