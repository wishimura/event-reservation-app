# ---------------------------------------------------------------------------
# Neon (Postgres)
# ---------------------------------------------------------------------------
# Neon console > your project > Connect > "Connection string".
# Use the POOLED connection (host contains "-pooler") and keep ?sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Admin console auth (/admin)
# ---------------------------------------------------------------------------
# Password for the admin login form.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# ---------------------------------------------------------------------------
# 予約確認メール (Resend)
# ---------------------------------------------------------------------------
# https://resend.com > API Keys で発行。
# 未設定の場合、メール送信はスキップされます（予約自体は成立します）。
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# 送信元アドレス。Resend で DNS 認証済みのドメインである必要があります。
MAIL_FROM="となりのと <noreply@example.com>"

# 新規予約の通知先（店舗）。空にすると店舗宛の通知は送りません。
SHOP_NOTIFICATION_EMAIL="shop@example.com"

# ---------------------------------------------------------------------------
# テスト用（本番では設定しないこと）
# ---------------------------------------------------------------------------
# "true" にすると /admin/login に ADMIN_PASSWORD を表示します。
# ログイン画面は誰でも開けるため、予約が入り始める前に必ず削除してください。
# SHOW_LOGIN_HINT="true"

# ---------------------------------------------------------------------------
# Square 決済
# ---------------------------------------------------------------------------
# 3つすべて揃うとカード決済に切り替わります。1つでも欠けていると
# 現地払い（受取時に店頭でお支払い）のまま動作します。
#
# 値は Square 開発者ダッシュボード（お店の Square アカウントでログイン）で取得します。
# SQUARE_ACCESS_TOKEN はお金を動かせる鍵です。取り扱いに注意してください。
SQUARE_ACCESS_TOKEN=""
SQUARE_APPLICATION_ID=""
SQUARE_LOCATION_ID=""

# "production" で本番、それ以外は Square のサンドボックス（テスト環境）。
SQUARE_ENVIRONMENT="sandbox"
